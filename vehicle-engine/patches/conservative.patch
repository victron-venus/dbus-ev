+package util
+
+import (
+	"crypto/rand"
+	"math/big"
+)
+
+// CryptoRandomString uses the OS cryptographic source for provider nonces and state.
+// The caller supplies a fixed public alphabet, not key material. Entropy failures
+// stop the process instead of silently falling back to predictable randomness.
+func CryptoRandomString(size int, alphabet []rune) string {
+	if size < 0 || len(alphabet) < 2 {
+		panic("invalid random string parameters")
+	}
+	out := make([]rune, size)
+	bound := big.NewInt(int64(len(alphabet)))
+	for i := range out {
+		n, err := rand.Int(rand.Reader, bound)
+		if err != nil {
+			panic(err)
+		}
+		out[i] = alphabet[n.Int64()]
+	}
+	return string(out)
+}
