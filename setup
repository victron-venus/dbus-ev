#!/bin/bash
#
# dbus-ev SetupHelper package script (PackageManager / GUI v1).
# Install logic lives in update.sh; this file is the SetupHelper entry point.
#

# Capture our option before SetupHelper consumes the command line. Ordinary
# PackageManager unattended installs reuse the persisted choice, without prompts.
haMqttOption=""
sourceOption=""
for argument in "$@"; do
    case "$argument" in
        --ha-mqtt=on) haMqttOption=on ;;
        --ha-mqtt=off) haMqttOption=off ;;
        --ha-mqtt=*) echo "Use --ha-mqtt=on or --ha-mqtt=off" >&2; exit 2 ;;
        --source=ha|--source=mercedes|--source=evcc) sourceOption=${argument#--source=} ;;
        --source=*) echo "Use --source=ha, mercedes or evcc" >&2; exit 2 ;;
    esac
done

#### following line incorporates SetupHelper resources into this script
source "/data/SetupHelper/HelperResources/IncludeHelpers"
#### end of lines to include helper resources

if [ "$scriptAction" == 'NONE' ]; then
    standardActionPrompt
fi

if [ "$scriptAction" == 'INSTALL' ]; then
    logMessage "Installing $packageName"
    if [ ! -f "$scriptDir/local_config.py" ] && [ -f "$scriptDir/local_config.example.py" ]; then
        cp "$scriptDir/local_config.example.py" "$scriptDir/local_config.py"
        logMessage "seeded local_config.py from example"
    fi
    if [ -n "$haMqttOption" ]; then
        python3 "$scriptDir/configure.py" --ha-mqtt "$haMqttOption" || exit $?
    elif $userInteraction && ! $reinstall && [ -t 0 ]; then
        echo "Publish vehicle telemetry to Home Assistant via Cerbo MQTT?"
        read -r -p "Enable (y), disable (n), or Enter to keep local_config.py/saved choice: " answer
        case "$answer" in
            y|Y) python3 "$scriptDir/configure.py" --ha-mqtt on || exit $? ;;
            n|N) python3 "$scriptDir/configure.py" --ha-mqtt off || exit $? ;;
        esac
    fi
    if [ -n "$sourceOption" ]; then
        python3 "$scriptDir/configure.py" --source "$sourceOption" || exit $?
    fi
    sh "$scriptDir/update.sh" "$scriptDir" || exit $?
fi

if [ "$scriptAction" == 'UNINSTALL' ]; then
    logMessage "Uninstalling $packageName"
    svc -dk "/service/dbus-ev/log" "/service/dbus-ev" 2>/dev/null || true
    rm -rf "/service/dbus-ev"
    if [ -f /data/rc.local ]; then
        sed -i '/# === dbus-ev service persistence ===/,/# === end dbus-ev ===/d' /data/rc.local 2>/dev/null || true
    fi
    # Keep local_config.py; PackageManager removes the package tree.
fi

# Services are installed by update.sh (symlink into /data/.../service),
# not by SetupHelper's INSTALL_SERVICE copier.
endScript
